<% panel_sync_attrs = KubikAi::Metatag::PanelSyncAttributes.for(metatagable) %>

<%= turbo_stream_from metatagable, :kubik_ai_metatag %>

<%= turbo_frame_tag KubikAi::Metatag::PanelDom.frame_id(metatagable), data: panel_sync_attrs do %>
  <%= render partial: "kubik_ai/admin/metatag_ai_panel", locals: { metatagable: metatagable } %>
<% end %>
