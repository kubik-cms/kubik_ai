<% focus = local_assigns[:focus] %>
<% runtime = KubikAi::Metatag::RuntimeState.fetch(metatagable, focus: focus) %>
<% pending = KubikAi::Metatag::SuggestionStore.fetch(metatagable, focus: focus).present? %>
<% status = runtime["status"].presence || "idle" %>
<% processing = %w[queued processing].include?(status) %>
<% panel_url = KubikAi::Metatag::Paths.panel_path(metatagable, focus: focus) %>
<% panel_header = KubikAi::Metatag::Focus.panel_header(focus) %>
<% trigger_label = KubikAi::Metatag::Focus.trigger_label(focus) %>

<%= kubik_offcanvas_open(
      url: panel_url,
      header: panel_header,
      tone: "white",
      label: trigger_label,
      html_class: [
        "kubik-ai-title-action",
        "kubik-ai-metatag-trigger",
        "kubik-ai-title-action--legend",
        ("kubik-ai-title-action--pending" if pending),
        ("kubik-ai-title-action--processing" if processing)
      ].compact.join(" "),
      pending: pending,
      icon: "smart_toy"
    ) %>
